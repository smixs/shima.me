---
import avatar from "../assets/avatar.png";
import { Image } from "astro:assets";
---

<section class="hero" aria-labelledby="hero-name">
  <canvas class="hero-grain" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="portrait">
      <Image src={avatar} alt="Serge Shima, cartoon portrait" width={400} height={400} loading="eager" fetchpriority="high" class="avatar" />
      <p class="bubble" id="hero-name">
        Serge Shima <span class="wave" aria-hidden="true">👋</span><!-- pinned brand greeting, taste-skill-ignore -->
      </p>
    </div>
    <h1 class="title">
      <span class="line"><span>Babai of creative AI</span></span>
      <span class="line line-2"><span>Turning ideas into impact</span></span>
    </h1>
    <p class="role">
      Co-founder &amp; CTO at <a href="https://majento.ai" rel="noopener">Majento</a> · AI agents for business
    </p>
    <a class="cta" href="https://t.me/aimastersme" rel="noopener">@aimastersme</a>
  </div>
</section>

<script>
  import { mountGrain } from "../scripts/grain-shader";
  const canvas = document.querySelector<HTMLCanvasElement>(".hero-grain");
  if (canvas) mountGrain(canvas);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: clamp(24px, 3vw, 36px);
    min-height: min(88svh, 780px);
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 55% at 50% 42%, #fbfbfa 0%, transparent 70%), /* pinned brand hero, taste-skill-ignore */
      var(--grain) 0 0 / 200px,
      #dcdcd9;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset, 0 30px 60px -40px rgba(23, 24, 28, 0.35); /* pinned brand hero, taste-skill-ignore */
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  :global(.hero-grain.is-live) {
    opacity: 1;
  }

  .hero-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(72px, 10vw, 120px) var(--gutter);
  }

  .portrait {
    position: relative;
    margin-bottom: clamp(36px, 5vw, 56px);
    animation: rise 900ms var(--ease-out) both;
  }

  .avatar {
    width: clamp(132px, 14vw, 176px);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    border: clamp(8px, 0.9vw, 12px) solid #f7f7f5;
    box-shadow: /* pinned brand hero, taste-skill-ignore */
      0 0 0 1px rgba(23, 24, 28, 0.06),
      0 18px 40px -18px rgba(23, 24, 28, 0.45);
  }

  .bubble {
    position: absolute;
    left: 78%;
    top: 26%;
    white-space: nowrap;
    font-size: clamp(0.95rem, 0.8rem + 0.5vw, 1.2rem);
    font-weight: 380;
    letter-spacing: -0.01em;
    background: #fdfdfc;
    padding: 0.7em 1.1em;
    border-radius: 999px;
    box-shadow: /* pinned brand hero, taste-skill-ignore */
      0 1px 0 rgba(255, 255, 255, 0.9) inset,
      0 10px 24px -10px rgba(23, 24, 28, 0.35);
    transform-origin: 0% 60%;
    animation:
      pop 700ms 350ms var(--ease-out) both,
      float 5s 1.1s ease-in-out infinite;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 80%;
    animation: wave 2.4s 1.2s ease-in-out 2;
  }

  .title {
    font-size: clamp(2.25rem, 1.2rem + 3.8vw, 4.25rem);
    font-weight: 720;
    letter-spacing: -0.04em;
    line-height: 1.04;
    display: grid;
    gap: 0.06em;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .line > span {
    display: inline-block;
    animation: lift 1000ms 200ms var(--ease-out) both;
  }

  .line-2 {
    color: var(--ink-2);
  }

  .line-2 > span {
    animation-delay: 320ms;
  }

  .role {
    margin-top: clamp(24px, 3vw, 36px);
    font-size: var(--step-1);
    color: var(--ink-2);
    animation: fade 800ms 600ms var(--ease-out) both;
  }

  .role a {
    color: var(--ink);
    font-weight: 560;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 2px;
  }

  .cta {
    margin-top: clamp(32px, 4vw, 44px);
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    background: var(--ink);
    color: #f6f6f4;
    font-weight: 560;
    text-decoration: none;
    letter-spacing: -0.005em;
    transition: transform 220ms var(--ease-out), background-color 220ms var(--ease-out);
    animation: fade 800ms 750ms var(--ease-out) both;
  }

  .cta:hover {
    background: #26282e;
    transform: translateY(-2px);
  }

  .cta:active {
    transform: translateY(0) scale(0.98);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.94);
      filter: blur(6px);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: rotate(-14deg) scale(0.6);
    }
    to {
      opacity: 1;
      transform: rotate(-6deg) scale(1);
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: rotate(-6deg) translateY(0);
    }
    50% {
      transform: rotate(-8deg) translateY(-5px);
    }
  }
  @keyframes wave {
    0%,
    60%,
    100% {
      transform: rotate(0);
    }
    10%,
    30% {
      transform: rotate(16deg);
    }
    20%,
    40% {
      transform: rotate(-8deg);
    }
  }
  @keyframes lift {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 0;
    }
    .title {
      font-size: 1.6rem;
    }
    .bubble {
      left: 50%;
      top: auto;
      bottom: -18px;
      translate: -50% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait,
    .line > span,
    .role,
    .cta,
    .wave {
      animation: none;
    }
    .bubble {
      animation: none;
      transform: rotate(-6deg);
    }
  }
</style>
