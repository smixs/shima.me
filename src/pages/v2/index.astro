---
import "../../styles/v2.css";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import { Image } from "astro:assets";
import repos from "../../data/repos.json";
import credits from "../../data/credits.json";
import { releases, log, mentions, clients, iva, askSerge } from "../../data/site";

import uiGithub from "../../assets/ui/github.jpg";
import uiChannel from "../../assets/ui/channel.jpg";
import uiMajento from "../../assets/ui/majento.jpg";
import uiSotish from "../../assets/ui/sotish.jpg";
import uiSezish from "../../assets/ui/sezish.jpg";
import uiClaimp from "../../assets/ui/claimp.jpg";
import uiAimasters from "../../assets/ui/aimasters.jpg";
import uiIva from "../../assets/ui/iva.jpg";
import uiIvaTree from "../../assets/ui/iva-2.jpg";
import dj from "../../assets/dj-shima.jpg";
import minsk from "../../assets/found/minsk-prospekt-nezalezhnosti-05.jpg";
import tashkent from "../../assets/found/soviet-postcard-tashkent-uzbek-ssr-1980-main.jpg";
import metro from "../../assets/found/tashkent-1988-metro.jpg";

const totalStars = repos.reduce((s, r) => s + r.stars, 0);
const fmt = (n: number) => n.toLocaleString("en-US");
const lineup = repos.filter((r) => r.name !== "smixs").slice(0, 16);

const shots: Record<string, ImageMetadata> = {
  majento: uiMajento,
  sotish: uiSotish,
  sezish: uiSezish,
  claimp: uiClaimp,
  aimasters: uiAimasters,
};
const focus: Record<string, string> = { majento: "92% 62%", aimasters: "100% 72%", sotish: "45% 96%", sezish: "50% 78%", claimp: "88% 62%" };
const kinds: Record<string, string> = { majento: "Company, since 2026", aimasters: "Education", sotish: "Telegram commerce", sezish: "Speech to text", claimp: "DJ software" };
const panels = releases.filter((r) => r.id !== "iva");

const eras = [
  {
    img: dj,
    alt: "Serge Shima behind the decks",
    span: "1998–2011",
    name: "Clubs in Minsk",
    text: "First set in 1998. From 2005 to 2011 co-founder and DJ of Re:fresh, the biggest raves in Belarus. Graduated BSPU in history and English.",
    roles: [] as string[],
  },
  {
    img: minsk,
    alt: "Independence Avenue in Minsk",
    span: "2012–2024",
    name: "Agencies, retail, a bank",
    text: "Twelve years of brand strategy and the first AI in production.",
    roles: log.filter((c) => c.date >= "2012" && c.date < "2024").map((c) => `${c.date.slice(0, 4)} · ${c.org}, ${c.role}. ${c.notes[0]}`),
  },
  {
    img: tashkent,
    alt: "Soviet postcard of Tashkent's main department store, 1980",
    span: "2024–now",
    name: "Tashkent",
    text: "Moved to Tashkent in 2024. Ran TDI Group as CEO / CTO for PepsiCo, Nestlé, Honor, Haval, KIA and Beeline, then co-founded Majento in May 2026.",
    roles: [] as string[],
  },
];

const used = new Set([
  "assets/minsk-prospekt-nezalezhnosti-05.jpg",
  "assets/soviet-postcard-tashkent-uzbek-ssr-1980-main.jpg",
  "assets/tashkent-1988-metro.jpg",
]);
const photoCredits = credits.filter((c) => used.has(c.file)).map((c) => c.credit);

const title = "Serge Shima: AI builder in Tashkent, co-founder & CTO at Majento";
const description = `Serge Shima (Сергей Шима) builds AI products in Tashkent: Majento, Iva, sotish, sezish, Claimp and open-source agent tools with ${fmt(totalStars)} GitHub stars. Brand strategist since 2012, DJ since 1998.`;
---

<Base title={title} description={description} path="/v2/" noindex>
  <header class="bar wrap">
    <a class="wordmark" href="/v2/">Serge Shima</a>
    <nav aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#iva">Iva</a>
      <a href="#open-source">Open source</a>
      <a href="#story">Story</a>
    </nav>
    <a class="bar-action" href="https://t.me/shimaoz" rel="noopener">Write on Telegram</a>
  </header>

  <main>
    <div class="wrap hero-wrap"><Hero /></div>

    <!-- intro: pinned statement, pictures pass beside it -->
    <section class="intro wrap" aria-label="Who is Serge Shima">
      <div class="intro-pin">
        <p class="intro-statement" data-in>
          Serge Shima builds AI products in Tashkent and ships them where people already are: Telegram, GitHub and client teams.
        </p>
        <p class="intro-body" data-in style="--i:1">
          Co-founder and CTO of Majento, founder of Aimasters, author of Iva. In AI since 2017; before that, twenty years of brand
          strategy behind the Halva card, a Grand Prix Effie and $21M of retail promos. 1000+ people trained in 50+ teams.
        </p>
      </div>
      <div class="intro-pics">
        <figure class="pic pic-a">
          <Image src={uiGithub} alt="Serge Shima's GitHub profile, smixs" widths={[640, 1100]} sizes="(max-width: 760px) 90vw, 34vw" />
          <figcaption>github.com/smixs · {repos.length} public repos, {fmt(totalStars)} stars</figcaption>
        </figure>
        <figure class="pic pic-b">
          <Image src={uiChannel} alt="The @aimastersme Telegram channel" widths={[640, 1100]} sizes="(max-width: 760px) 90vw, 30vw" />
          <figcaption>t.me/aimastersme · 6,847 readers</figcaption>
        </figure>
        <figure class="pic pic-c">
          <Image src={metro} alt="Tashkent metro station, 1988" widths={[480, 800]} sizes="(max-width: 760px) 70vw, 22vw" />
          <figcaption>Tashkent, home since 2024</figcaption>
        </figure>
      </div>
    </section>

    <!-- work: full panels, one midline row -->
    <section id="work" class="work" aria-labelledby="work-h">
      <h2 id="work-h" class="visually-hidden">Companies and products</h2>
      {
        panels.map((r) => (
          <article class="panel" id={`release-${r.id}`}>
            <Image src={shots[r.id]} alt={`${r.name} website`} widths={[960, 1600, 2200]} sizes="100vw" class="panel-img" style={`object-position:${focus[r.id]};transform-origin:${focus[r.id]}`} />
            <div class="panel-row">
              <span class="panel-year">{kinds[r.id]}</span>
              <div class="panel-title">
                <h3 class="poster">{r.name}</h3>
                <p>{r.line}</p>
              </div>
              <a class="panel-link" href={r.links[0].href} rel="noopener">
                {r.links[0].label}
              </a>
            </div>
          </article>
        ))
      }
    </section>

    <!-- showcase: Iva, one frame at three distances -->
    <section id="iva" class="iva" aria-labelledby="iva-h">
      <div class="iva-run">
        <div class="iva-stage">
          <h2 id="iva-h" class="iva-head">
            <span class="iva-top poster">Iva remembers</span>
            <span class="iva-bottom poster">what you tell it</span>
          </h2>
          <div class="iva-frame" data-stage="0">
            <Image src={uiIvaTree} alt="Iva's memory tree: leaves, branches and trunk" widths={[900, 1600]} sizes="(max-width: 760px) 80vw, 36vw" loading="lazy" />
          </div>
          <ol class="iva-captions">
            {
              iva.tree.map((t, i) => (
                <li data-cap={i}>
                  <strong>{t.name}.</strong> {t.text}
                </li>
              ))
            }
          </ol>
        </div>
        <span class="iva-marker" data-to="0"></span>
        <span class="iva-marker" data-to="1"></span>
        <span class="iva-marker" data-to="2"></span>
      </div>

      <div class="iva-detail wrap">
        <div class="iva-lead">
          <p class="iva-statement" data-in>
            Iva is a personal AI assistant in your Telegram chat. It files, remembers and acts on your own server.
          </p>
          <pre class="iva-install" data-in style="--i:1"><code>{iva.install}</code></pre>
          <p class="iva-links" data-in style="--i:2">
            <a class="btn" href={iva.site} rel="noopener">Open iva-agent.com</a>
            <a href={iva.repo} rel="noopener">Source on GitHub, {fmt(repos.find((r) => r.name === "iva-agent")?.stars ?? 0)} stars</a>
          </p>
        </div>
        <ul class="iva-features">
          {
            iva.features.map((f, i) => (
              <li data-in style={`--i:${i % 4}`}>
                <h3>{f.name}</h3>
                <p>{f.text}</p>
              </li>
            ))
          }
        </ul>
        <figure class="iva-shot" data-in>
          <Image src={uiIva} alt="The iva-agent.com home page" widths={[900, 1600]} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" />
        </figure>

        <div class="ask" data-ui aria-labelledby="ask-h">
          <h3 id="ask-h">Ask about Serge</h3>
          <p class="ask-note">A sample chat in Iva's format. The answers come from the facts on this page.</p>
          <div class="ask-chat" aria-live="polite">
            <p class="msg msg-in">Pick a question below.</p>
          </div>
          <div class="ask-qs">
            {askSerge.map((x, i) => (
              <button type="button" class="ask-q" data-q={i}>
                {x.q}
              </button>
            ))}
          </div>
          <noscript>
            <dl class="ask-fallback">
              {askSerge.map((x) => (
                <>
                  <dt>{x.q}</dt>
                  <dd>{x.a}</dd>
                </>
              ))}
            </dl>
          </noscript>
        </div>
      </div>
    </section>

    <!-- list: line-up at one type size -->
    <section id="open-source" class="lineup wrap" aria-labelledby="os-h">
      <h2 id="os-h" class="lineup-head">Open source · {fmt(totalStars)} stars on GitHub</h2>
      <table>
        <caption class="visually-hidden">Public repositories by stars</caption>
        <thead class="visually-hidden">
          <tr><th>Repository</th><th>What it does</th><th>Language</th><th>Stars</th></tr>
        </thead>
        <tbody>
          {
            lineup.map((r) => (
              <tr>
                <td><a href={r.url} rel="noopener">{r.name}</a></td>
                <td class="l-what">{r.description ?? ""}</td>
                <td class="l-lang">{r.language ?? "Markdown"}</td>
                <td class="l-stars">{fmt(r.stars)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="lineup-more"><a href="https://github.com/smixs?tab=repositories" rel="noopener">All {repos.length} repositories on GitHub</a></p>
    </section>

    <!-- about: pinned title, eras pass -->
    <section id="story" class="story" aria-labelledby="story-h">
      <div class="story-pin">
        <h2 id="story-h" class="poster">Since 1998</h2>
      </div>
      <ol class="eras wrap">
        {
          eras.map((e, i) => (
            <li class:list={["era", i % 2 ? "era-right" : "era-left"]}>
              <figure data-in>
                <Image src={e.img} alt={e.alt} widths={[600, 1000]} sizes="(max-width: 760px) 72vw, 28vw" />
              </figure>
              <div class="era-text" data-in style="--i:1">
                <p class="era-name">{e.span} · {e.name}</p>
                <p>{e.text}</p>
                {e.roles.length > 0 && (
                  <ul class="era-roles">
                    {e.roles.map((r) => (
                      <li>{r}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- proof: names running off the edges -->
    <section class="proof" aria-labelledby="proof-h">
      <h2 id="proof-h" class="visually-hidden">Brands and stages</h2>
      <div class="band" aria-hidden="true">
        <div class="band-track">
          {[0, 1].map(() => (
            <span class="band-line poster">
              {clients.map((c) => (
                <>
                  {c}
                  <i class="dot" />
                </>
              ))}
            </span>
          ))}
        </div>
      </div>
      <div class="proof-text wrap">
        <p class="proof-sentence" data-in>
          Brands Serge has worked for in agencies, in his own companies and in corporate training: {clients.join(", ")}.
        </p>
        <ul class="talks">
          {
            mentions.map((m, i) => (
              <li data-in style={`--i:${i % 4}`}>
                {m.href ? <a href={m.href} rel="noopener">{m.outlet}</a> : <span>{m.outlet}</span>}
                <span class="talk-what">{m.title}{m.date ? `, ${m.date.slice(0, 4)}` : ""}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- contact: card on a photograph -->
    <section id="contact" class="visit" aria-labelledby="visit-h">
      <Image src={tashkent} alt="" widths={[1024]} sizes="100vw" class="visit-img" loading="lazy" />
      <div class="visit-card">
        <h2 id="visit-h">Write to Serge</h2>
        <p>Tashkent, Uzbekistan</p>
        <dl>
          <div><dt>Telegram</dt><dd><a href="https://t.me/shimaoz">@shimaoz</a></dd></div>
          <div><dt>Email</dt><dd><a href="mailto:hello@shima.me">hello@shima.me</a></dd></div>
          <div><dt>Channel</dt><dd><a href="https://t.me/aimastersme">@aimastersme</a></dd></div>
          <div><dt>Short CV</dt><dd><a href="https://sergeshima.com">sergeshima.com</a></dd></div>
        </dl>
        <a class="btn visit-btn" href="https://t.me/shimaoz" rel="noopener">Message on Telegram</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-top wrap">
      <div>
        <p class="foot-invite">Build an AI product together</p>
        <a class="btn" href="https://t.me/shimaoz" rel="noopener">Start on Telegram</a>
      </div>
      <ul class="foot-links">
        <li><a href="https://github.com/smixs">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/sergeshima">LinkedIn</a></li>
        <li><a href="https://www.youtube.com/@SergeShima">YouTube</a></li>
        <li><a href="https://www.instagram.com/serge.shima">Instagram</a></li>
      </ul>
    </div>
    <p class="foot-credits wrap">Photographs: {photoCredits.join(" · ")}. Product pictures are screenshots of the live sites.</p>
    <p class="foot-name poster" aria-hidden="true">Shima</p>
  </footer>
</Base>

<script>
  import { askSerge } from "../../data/site";

  // Section entrances.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: "0px 0px -10% 0px" },
  );
  document.querySelectorAll("[data-in]").forEach((el) => io.observe(el));

  // Iva frame: three distances on three scroll markers.
  const frame = document.querySelector<HTMLElement>(".iva-frame");
  const stage = document.querySelector<HTMLElement>(".iva-stage");
  const mo = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const to = (e.target as HTMLElement).dataset.to ?? "0";
        frame?.setAttribute("data-stage", to);
        stage?.setAttribute("data-stage", to);
      }
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  document.querySelectorAll(".iva-marker").forEach((m) => mo.observe(m));

  // Ask about Serge.
  const chat = document.querySelector<HTMLElement>(".ask-chat");
  document.querySelectorAll<HTMLButtonElement>(".ask-q").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = askSerge[Number(btn.dataset.q)];
      if (!chat || !item) return;
      chat.innerHTML = "";
      const q = document.createElement("p");
      q.className = "msg msg-out";
      q.textContent = item.q;
      const a = document.createElement("p");
      a.className = "msg msg-in is-typing";
      a.textContent = "Iva is typing";
      chat.append(q, a);
      setTimeout(() => {
        a.classList.remove("is-typing");
        a.textContent = item.a;
      }, 650);
    });
  });
</script>

<style>
  /* Bar */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
  }
  .wordmark {
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .bar nav {
    display: flex;
    gap: 28px;
  }
  .bar nav a,
  .bar-action {
    text-decoration: none;
    font-weight: 500;
  }
  .bar nav a:hover,
  .bar-action:hover {
    text-decoration: underline;
  }
  .bar-action {
    background: var(--ink);
    color: var(--bg);
    padding: 10px 16px;
    font-size: var(--step-small);
  }
  .bar-action:hover {
    text-decoration: none;
    background: #2b2d33;
  }
  @media (max-width: 760px) {
    .bar nav {
      display: none;
    }
  }

  /* Intro */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
    padding-top: var(--gap-section);
  }
  .intro-pin {
    position: sticky;
    top: 18vh;
    align-self: start;
    display: grid;
    gap: 28px;
  }
  .intro-statement {
    font-size: var(--step-head);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .intro-body {
    max-width: 46ch;
  }
  .intro-pics {
    display: grid;
    gap: 10vh;
    padding-block: 0 4vh;
  }
  .pic {
    margin: 0;
  }
  .pic :global(img) {
    width: 100%;
    object-fit: cover;
  }
  .pic figcaption {
    margin-top: 12px;
    font-size: var(--step-small);
    color: var(--muted);
  }
  .pic-a {
    width: 92%;
  }
  .pic-a :global(img) {
    aspect-ratio: 4 / 5;
    object-position: 20% 0;
  }
  .pic-b {
    width: 78%;
    justify-self: end;
  }
  .pic-b :global(img) {
    aspect-ratio: 16 / 10;
    object-position: 30% 0;
  }
  .pic-c {
    width: 52%;
    margin-left: 12%;
  }
  .pic-c :global(img) {
    aspect-ratio: 1;
    filter: grayscale(1) contrast(1.05);
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .intro-pin {
      position: static;
    }
    .intro-pics {
      gap: 48px;
    }
    .pic-a,
    .pic-b,
    .pic-c {
      width: 100%;
      margin: 0;
    }
  }

  /* Work panels */
  .work {
    margin-top: var(--gap-section);
  }
  .panel {
    position: relative;
    height: 72svh;
    overflow: hidden;
    background: var(--ink);
    scroll-margin-top: 0;
  }
  .panel :global(.panel-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.4);
    filter: brightness(0.58) saturate(0.75);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .panel-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    grid-template-columns: 16% minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 22px var(--margin);
    background: rgba(22, 23, 27, 0.86);
    color: var(--on-inverse);
  }
  .panel-year {
    font-size: var(--step-small);
  }
  .panel-title {
    display: flex;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .panel-title h3 {
    font-size: var(--step-lead);
  }
  .panel-title p {
    max-width: 60ch;
    color: #d6d6d2;
  }
  .panel-link {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .panel-link:hover {
    text-decoration: underline;
  }
  @keyframes drift {
    to {
      transform: scale(1.5);
    }
  }
  @media (max-width: 760px) {
    .panel {
      height: 82svh;
    }
    .panel-row {
      top: auto;
      bottom: 20px;
      translate: none;
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
    }
    .panel-title {
      grid-column: 1 / -1;
      grid-row: 1;
      display: grid;
      gap: 6px;
    }
    .panel-year {
      grid-row: 2;
    }
    .panel-link {
      grid-row: 2;
      justify-self: end;
    }
  }

  /* Iva */
  .iva {
    position: relative;
    z-index: 1;
    background: var(--bg);
    padding-top: var(--gap-section);
  }
  .iva-run {
    position: relative;
    height: 250svh;
  }
  .iva-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .iva-head {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding-block: 9svh;
    pointer-events: none;
  }
  .iva-head span {
    font-size: var(--step-head);
    font-weight: 800;
  }
  .iva-top {
    grid-row: 1;
  }
  .iva-bottom {
    grid-row: 3;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out);
  }
  .iva-stage[data-stage="1"] .iva-bottom,
  .iva-stage[data-stage="2"] .iva-bottom {
    opacity: 1;
    transform: none;
  }
  .iva-frame {
    height: 46svh;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0b0b0c;
  }
  .iva-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(2.3);
    transform-origin: 9% 64%;
    transition: transform 1000ms var(--ease-out), transform-origin 1000ms var(--ease-out);
  }
  .iva-frame[data-stage="1"] :global(img) {
    transform: scale(2);
    transform-origin: 50% 58%;
  }
  .iva-frame[data-stage="2"] :global(img) {
    transform: scale(2.3);
    transform-origin: 89% 64%;
  }
  .iva-captions {
    position: absolute;
    right: var(--margin);
    top: 50%;
    translate: 0 -50%;
    width: min(28ch, 24vw);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .iva-captions li {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
    transform: translateY(12px);
